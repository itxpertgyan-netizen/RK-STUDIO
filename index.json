<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>RK Studio | Digital Album</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  min-height:100vh;
  background:#111;
  color:white;
  font-family:Arial,Helvetica,sans-serif;
  overflow-x:hidden;
}

header{
  text-align:center;
  padding:25px 15px;
  background:linear-gradient(135deg,#24180d,#0d0d0d);
}

header h1{
  margin:0;
  font-size:32px;
  letter-spacing:3px;
}

header p{
  margin:8px 0 0;
  color:#ddd;
}

.album-area{
  max-width:1100px;
  margin:auto;
  padding:25px 15px 50px;
}

.book{
  width:100%;
  max-width:900px;
  margin:auto;
}

.page{
  min-height:500px;
  border-radius:15px;
  margin-bottom:20px;
  padding:25px;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  text-align:center;

  background:
    linear-gradient(135deg,#292929,#151515);

  border:1px solid #555;
  box-shadow:0 12px 35px rgba(0,0,0,.5);
}

.cover{
  min-height:500px;
  background:
    radial-gradient(circle at center,#65471f,#17100a 70%);
}

.cover h2{
  font-size:40px;
  margin:15px 0 5px;
}

.cover .icon{
  font-size:70px;
}

.cover p{
  color:#ddd;
}

.photo-box{
  width:90%;
  max-width:650px;
  aspect-ratio:16/10;

  display:flex;
  align-items:center;
  justify-content:center;

  border:2px dashed #777;
  border-radius:12px;
  background:#202020;

  font-size:45px;
}

.page-number{
  margin-top:18px;
  color:#aaa;
  font-size:14px;
}

.buttons{
  text-align:center;
  margin-top:25px;
}

button{
  border:0;
  border-radius:10px;
  padding:12px 20px;
  margin:5px;
  background:#333;
  color:white;
  cursor:pointer;
  font-size:15px;
}

button:hover{
  background:#555;
}

footer{
  text-align:center;
  padding:25px;
  color:#888;
}

@media(max-width:600px){

  header h1{
    font-size:25px;
  }

  .page,
  .cover{
    min-height:400px;
  }

  .cover h2{
    font-size:28px;
  }

  .photo-box{
    width:100%;
  }
}
</style>
</head>

